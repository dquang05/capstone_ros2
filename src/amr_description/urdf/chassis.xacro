<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================================================== -->
  <!-- Base Footprint & Base Link (REP-105 Compliant)       -->
  <!-- ==================================================== -->

  <!-- base_footprint: 2D projection on ground surface (z = 0) -->
  <link name="base_footprint"/>

  <!-- base_link: Center of rotation on active drive axle -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link"/>

  <!-- ==================================================== -->
  <!-- Chassis Body Link (Visual Meshes & Analytical Physics) -->
  <!-- ==================================================== -->

  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="chassis_link">
    <!-- Visual 1: Main Base Chassis Structure -->
    <visual>
      <origin xyz="-0.38 -0.30 -0.04" rpy="${pi/2} 0 ${pi/2}"/>
      <geometry>
        <mesh filename="package://amr_description/meshes/visual/chassis.stl" scale="1 1 1"/>
      </geometry>
      <material name="robot_white"/>
    </visual>

    <!-- Visual 2: Exterior Body Housing -->
    <visual>
      <origin xyz="-0.38 -0.30 -0.04" rpy="${pi/2} 0 ${pi/2}"/>
      <geometry>
        <mesh filename="package://amr_description/meshes/visual/housing.stl" scale="1 1 1"/>
      </geometry>
      <material name="robot_accent"/>
    </visual>

    <!-- Visual 3: Top Cover -->
    <visual>
      <origin xyz="-0.38 -0.30 0.85" rpy="${pi/2} 0 ${pi/2}"/>
      <geometry>
        <mesh filename="package://amr_description/meshes/visual/top_cover.stl" scale="1 1 1"/>
      </geometry>
      <material name="robot_white"/>
    </visual>

    <!-- Visual 4: Food Delivery Trays (3 Tiers) -->
    <!-- Tier 1 Tray -->
    <visual>
      <origin xyz="0 0 0.22" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://amr_description/meshes/visual/tray.stl" scale="1 1 1"/>
      </geometry>
      <material name="robot_metal"/>
    </visual>

    <!-- Tier 2 Tray -->
    <visual>
      <origin xyz="0 0 0.48" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://amr_description/meshes/visual/tray.stl" scale="1 1 1"/>
      </geometry>
      <material name="robot_metal"/>
    </visual>

    <!-- Tier 3 Tray -->
    <visual>
      <origin xyz="0 0 0.74" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://amr_description/meshes/visual/tray.stl" scale="1 1 1"/>
      </geometry>
      <material name="robot_metal"/>
    </visual>

    <!-- Visual 5: Screen / Head Mount -->
    <visual>
      <origin xyz="0.10 0 0.95" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://amr_description/meshes/visual/head.stl" scale="1 1 1"/>
      </geometry>
      <material name="robot_dark"/>
    </visual>

    <!-- Collision Geometry: Simple Analytical Box for High Performance & Zero-Jitter Physics -->
    <collision>
      <origin xyz="0 0 0.45" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} 0.90"/>
      </geometry>
    </collision>

    <!-- Analytical Inertia: Strictly Positive Definite (Prevents Gazebo NaN explosions) -->
    <xacro:inertial_box mass="${base_mass}" x="${chassis_length}" y="${chassis_width}" z="0.90">
      <origin xyz="${com_x} ${com_y} ${com_z}" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <!-- Gazebo Material Settings for Chassis -->
  <gazebo reference="chassis_link">
    <material>Gazebo/White</material>
  </gazebo>

</robot>
