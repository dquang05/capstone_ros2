<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================================================== -->
  <!-- Base Chassis Plate (Centered at X=0, Y=0, Z_ground=40mm) -->
  <!-- ==================================================== -->

  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="chassis_link">
    <!-- Visual: Base Chassis Plate STL -->
    <visual>
      <origin xyz="${-chassis_length/2.0} ${-chassis_width/2.0} ${chassis_z_offset}" rpy="${pi/2} 0 ${pi/2}"/>
      <geometry>
        <mesh filename="package://amr_description/meshes/visual/chassis.stl" scale="1 1 1"/>
      </geometry>
      <material name="robot_metal"/>
    </visual>

    <!-- Collision: Analytical Box Plate -->
    <collision>
      <origin xyz="0 0 ${chassis_z_offset + chassis_thickness/2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_thickness}"/>
      </geometry>
    </collision>

    <!-- Inertial: Analytical Box Inertia (${chassis_mass}kg steel/aluminum plate) -->
    <xacro:inertial_box mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_thickness}">
      <origin xyz="0 0 ${chassis_z_offset + chassis_thickness/2.0}" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <gazebo reference="chassis_link">
    <material>Gazebo/Grey</material>
  </gazebo>

</robot>
