<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Color definitions for RViz -->
  <material name="robot_white">
    <color rgba="0.92 0.93 0.95 1.0"/>
  </material>

  <material name="robot_dark">
    <color rgba="0.15 0.16 0.18 1.0"/>
  </material>

  <material name="robot_metal">
    <color rgba="0.75 0.77 0.80 1.0"/>
  </material>

  <material name="robot_accent">
    <color rgba="0.12 0.53 0.90 1.0"/>
  </material>

  <material name="robot_wheel">
    <color rgba="0.22 0.22 0.24 1.0"/>
  </material>

  <material name="robot_caster">
    <color rgba="0.85 0.85 0.85 1.0"/>
  </material>

  <material name="robot_sensor">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>

</robot>
