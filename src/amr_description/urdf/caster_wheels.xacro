<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================================================== -->
  <!-- Passive Caster Wheel Macro (Frictionless Sphere)    -->
  <!-- ==================================================== -->

  <xacro:macro name="caster_wheel" params="prefix x_pos y_pos">
    <joint name="caster_${prefix}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="caster_${prefix}_link"/>
      <origin xyz="${x_pos} ${y_pos} ${caster_z_offset}" rpy="0 0 0"/>
    </joint>

    <link name="caster_${prefix}_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://amr_description/meshes/visual/caster_wheel.stl" scale="1 1 1"/>
        </geometry>
        <material name="robot_caster"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
      </collision>
      <xacro:inertial_sphere mass="${caster_mass}" radius="${caster_radius}">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_sphere>
    </link>

    <!-- Gazebo physics: 0 friction ensures smooth omnidirectional sliding without jamming -->
    <gazebo reference="caster_${prefix}_link">
      <material>Gazebo/Grey</material>
      <mu1 value="0.0"/>
      <mu2 value="0.0"/>
      <kp value="1000000.0"/>
      <kd value="100.0"/>
    </gazebo>
  </xacro:macro>

  <!-- Instantiate 4 Casters according to Capstone Specs (L = 0.33m, Spacing = 0.40m -> y = +/- 0.20m) -->
  <xacro:caster_wheel prefix="fl" x_pos="${caster_x_offset}"  y_pos="${caster_y_offset}"/>
  <xacro:caster_wheel prefix="fr" x_pos="${caster_x_offset}"  y_pos="-${caster_y_offset}"/>
  <xacro:caster_wheel prefix="rl" x_pos="-${caster_x_offset}" y_pos="${caster_y_offset}"/>
  <xacro:caster_wheel prefix="rr" x_pos="-${caster_x_offset}" y_pos="-${caster_y_offset}"/>

</robot>
