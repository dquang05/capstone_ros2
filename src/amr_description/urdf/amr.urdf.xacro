<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="amr">

  <!-- ==================================================== -->
  <!-- Core Modular Libraries                               -->
  <!-- ==================================================== -->
  <xacro:include filename="properties.xacro" />
  <xacro:include filename="materials.xacro" />
  <xacro:include filename="macros_inertia.xacro" />

  <!-- ==================================================== -->
  <!-- REP-105 Root Frames: base_footprint & base_link      -->
  <!-- ==================================================== -->

  <!-- base_footprint: 2D projection on ground surface (Z = 0) -->
  <link name="base_footprint"/>

  <!-- base_link: Center of rotation on active drive axle (Z = wheel_radius = 0.075m) -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link"/>

  <!-- ==================================================== -->
  <!-- Robot Structural Components                          -->
  <!-- ==================================================== -->
  <xacro:include filename="chassis.xacro" />
  <xacro:include filename="drive_wheels.xacro" />
  <xacro:include filename="caster_wheels.xacro" />
  <xacro:include filename="food_trays.xacro" />
  <xacro:include filename="lidar.xacro" />
  <xacro:include filename="imu.xacro" />

  <!-- ==================================================== -->
  <!-- Gazebo Simulation Plugins & Encoder Feedback         -->
  <!-- ==================================================== -->
  <xacro:include filename="gazebo.xacro" />

</robot>
