<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================================================== -->
  <!-- Gazebo Simulation & Hardware Feedback Plugins        -->
  <!-- ==================================================== -->

  <!-- Joint State Publisher Plugin (Wheel Encoders Feedback) -->
  <!-- Publishes sensor_msgs/JointState on /joint_states     -->
  <!-- Provides angular position (rad -> revolutions) and    -->
  <!-- angular velocity (rad/s -> RPM) for each drive wheel  -->
  <gazebo>
    <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <update_rate>50</update_rate>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- Differential Drive Controller Plugin -->
  <!-- Drives active wheels via /cmd_vel and calculates     -->
  <!-- odometry integration from wheel encoder feedback     -->
  <gazebo>
    <plugin name="diff_drive_controller" filename="libgazebo_ros_diff_drive.so">
      <update_rate>50</update_rate>

      <!-- Wheel joints -->
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <!-- Kinematic parameters from properties.xacro -->
      <wheel_separation>${wheel_track}</wheel_separation>
      <wheel_diameter>${2.0 * wheel_radius}</wheel_diameter>

      <!-- Dynamic limits -->
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>

      <!-- Topics & Frames -->
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>wheel/odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>

      <!-- Odometry and TF broadcasting -->
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
    </plugin>
  </gazebo>

</robot>
