  <version>0.0.0</version>
  <description>Gazebo simulation worlds and launch files for Food Delivery AMR</description>
  <maintainer email="trandanhquang2005@gmail.com">quangtran</maintainer>
  <license>TODO: License declaration</license>

  <test_depend>ament_copyright</test_depend>
