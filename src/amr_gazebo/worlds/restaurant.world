<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="restaurant_world">

    <!-- Physics Engine Configuration (Smooth 250 Hz for Differential Drive AMR) -->
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential Gazebo Harmonic System Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <!-- Sun Directional Light (Soft shadows disabled for maximum FPS) -->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Scene Lighting & Background (Even bright ambient lighting) -->
    <scene>
      <ambient>0.85 0.85 0.85 1.0</ambient>
      <background>0.90 0.90 0.92 1.0</background>
      <shadows>false</shadows>
      <grid>false</grid>
    </scene>

    <!-- Global Ground Plane (Smooth polished restaurant tile floor) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.88 0.88 0.90 1</ambient><diffuse>0.88 0.88 0.90 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================== -->
    <!-- COMPLETE LOW-POLY RESTAURANT STRUCTURE (Exact Image Layout)    -->
    <!-- Realistic 4-Legged Tables & Chairs (LiDAR passes under seats)  -->
    <!-- ============================================================== -->
    <model name="restaurant_structure">
      <static>true</static>

      <!-- 1. Outer Boundary Walls (16.0m x 10.0m x 2.4m, thickness 0.15m) -->
      <link name="outer_walls">
        <visual name="wall_north_vis"><pose>0 5.0 1.2 0 0 0</pose><geometry><box><size>16.0 0.15 2.4</size></box></geometry><material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.3 0.3 0.32 1</diffuse></material></visual>
        <collision name="wall_north_col"><pose>0 5.0 1.2 0 0 0</pose><geometry><box><size>16.0 0.15 2.4</size></box></geometry></collision>
        <visual name="wall_south_vis"><pose>0 -5.0 1.2 0 0 0</pose><geometry><box><size>16.0 0.15 2.4</size></box></geometry><material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.3 0.3 0.32 1</diffuse></material></visual>
        <collision name="wall_south_col"><pose>0 -5.0 1.2 0 0 0</pose><geometry><box><size>16.0 0.15 2.4</size></box></geometry></collision>
        <visual name="wall_west_vis"><pose>-8.0 0 1.2 0 0 0</pose><geometry><box><size>0.15 10.0 2.4</size></box></geometry><material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.3 0.3 0.32 1</diffuse></material></visual>
        <collision name="wall_west_col"><pose>-8.0 0 1.2 0 0 0</pose><geometry><box><size>0.15 10.0 2.4</size></box></geometry></collision>
        <visual name="wall_east_vis"><pose>8.0 0 1.2 0 0 0</pose><geometry><box><size>0.15 10.0 2.4</size></box></geometry><material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.3 0.3 0.32 1</diffuse></material></visual>
        <collision name="wall_east_col"><pose>8.0 0 1.2 0 0 0</pose><geometry><box><size>0.15 10.0 2.4</size></box></geometry></collision>
      </link>

