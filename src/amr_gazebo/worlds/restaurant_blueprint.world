      <!-- 7. CENTRAL GREENERY DINING ISLAND (GROUP_CENTER: Ô trung tâm chậu cây + 4 bàn ăn + 8 ghế) -->
      <!-- Kích thước căn chuẩn xác theo số đo thực tế từ bản vẽ: -->
      <!--   - Tâm vòng tròn ảo: X = -3.195m, Y = -0.140m (dời tịnh tiến lên phía Bắc 1.28m đồng bộ cùng Cụm Bắc) -->
      <!--   - Bán kính vòng tròn ảo: R = 1.95m (mặt sàn ước lệ mỏng 2mm, không va chạm) -->
      <!--   - Chậu cây vuông trung tâm: Cạnh 0.89m x 0.89m x Cao 0.50m tại tâm (-3.195, -0.140), có cây xanh cao 2.1m -->
      <!--   - 4 Bàn ăn chuẩn Group 01 (0.67m x 1.38m x 0.75m), cách cạnh chậu cây đúng 0.30m: -->
      <!--     * Bàn Bắc: Tâm (-3.195, 0.940, 0.375), dài 1.38m theo trục X, 2 ghế phía Bắc tại Y = 1.436m -->
      <!--     * Bàn Nam: Tâm (-3.195, -1.220, 0.375), dài 1.38m theo trục X, 2 ghế phía Nam tại Y = -1.716m -->
      <!--     * Bàn Đông: Tâm (-2.115, -0.140, 0.375), dài 1.38m theo trục Y, 2 ghế phía Đông tại X = -1.619m -->
      <!--     * Bàn Tây: Tâm (-4.275, -0.140, 0.375), dài 1.38m theo trục Y, 2 ghế phía Tây tại X = -4.771m -->
      <!--   - Mỗi bàn có 2 ghế ăn chuẩn Group 01 (0.28m x 0.28m x 0.75m) đặt ở phía ngoài đối xứng -->
      <link name="group_center">

        <!-- [VÒNG TRÒN ẢO GROUP_CENTER - MẶT SÀN ƯỚC LỆ KHÔNG VA CHẠM: Bán kính R = 1.95m] -->
        <visual name="group_center_floor_disc_vis">
          <pose>-3.195 -0.140 0.003 0 0 0</pose>
          <geometry><cylinder><radius>1.95</radius><length>0.002</length></cylinder></geometry>
          <material>
            <ambient>0.84 0.84 0.86 1</ambient>
            <diffuse>0.84 0.84 0.86 1</diffuse>
          </material>
        </visual>

        <!-- [CHẬU CÂY VUÔNG TRUNG TÂM: Cạnh 0.89m x 0.89m x Cao 0.50m] -->
        <visual name="center_planter_vis">
          <pose>-3.195 -0.140 0.250 0 0 0</pose>
          <geometry><box><size>0.89 0.89 0.50</size></box></geometry>
          <material>
            <ambient>0.45 0.40 0.35 1</ambient>
            <diffuse>0.55 0.50 0.45 1</diffuse>
          </material>
        </visual>
        <collision name="center_planter_col">
          <pose>-3.195 -0.140 0.250 0 0 0</pose>
          <geometry><box><size>0.89 0.89 0.50</size></box></geometry>
        </collision>

        <!-- Đất chậu cây -->
        <visual name="center_planter_soil_vis">
          <pose>-3.195 -0.140 0.505 0 0 0</pose>
          <geometry><box><size>0.81 0.81 0.02</size></box></geometry>
          <material>
            <ambient>0.20 0.15 0.10 1</ambient>
            <diffuse>0.25 0.18 0.12 1</diffuse>
          </material>
        </visual>

        <!-- Thân cây cảnh -->
        <visual name="center_tree_trunk_vis">
          <pose>-3.195 -0.140 1.200 0 0 0</pose>
          <geometry><cylinder><radius>0.10</radius><length>1.40</length></cylinder></geometry>
          <material>
            <ambient>0.35 0.25 0.15 1</ambient>
            <diffuse>0.40 0.30 0.20 1</diffuse>
          </material>
        </visual>
        <collision name="center_tree_trunk_col">
          <pose>-3.195 -0.140 1.200 0 0 0</pose>
          <geometry><cylinder><radius>0.10</radius><length>1.40</length></cylinder></geometry>
        </collision>

        <!-- Tán cây xanh mát -->
        <visual name="center_tree_foliage_vis">
          <pose>-3.195 -0.140 2.100 0 0 0</pose>
          <geometry><sphere><radius>0.85</radius></sphere></geometry>
          <material>
            <ambient>0.15 0.50 0.20 1</ambient>
            <diffuse>0.20 0.60 0.25 1</diffuse>
          </material>
        </visual>

        <!-- ==================== BÀN BẮC & 2 GHẾ (NORTH TABLE) ==================== -->
