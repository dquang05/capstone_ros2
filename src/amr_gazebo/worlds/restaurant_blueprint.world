      <!-- 15. ROOMS 06 & 07 (Phòng 06 & 07 - Che kín hoàn toàn phía Tây sau lưng trạm Robot) -->
      <!-- Kích thước đo đạc chuẩn xác: -->
      <!--   - Phòng 07 (Hình hộp chữ nhật/vuông): Rộng 2.27m x Dài 2.18m x Cao 2.80m -->
      <!--     Dựa lưng vào tường xanh lá dock robot (X = 6.605m) và đường chuẩn (Y = -2.510m) -->
      <!--   - Phòng 06 (Hình bán nguyệt): Bán kính R = 1.09m (đường kính 2.18m khớp hoàn toàn với phòng 07) -->
      <!--   - Khoảng cách đến đầu dãy bàn quầy Bar phía Tây đúng 1.00m để có lối đi cho Robot -->
      <link name="rooms_06_07">

        <!-- [PHÒNG 07 - KHỐI HỘP VUÔNG KÍN HOÀN TOÀN: 2.27m x 2.18m x 2.80m] -->
