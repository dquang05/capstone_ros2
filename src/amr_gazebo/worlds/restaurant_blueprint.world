<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="restaurant_blueprint_world">

    <!-- ============================================================== -->
    <!-- Physics Engine Configuration (Smooth 250 Hz for Real-time Sim) -->
    <!-- ============================================================== -->
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential Gazebo Harmonic System Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <!-- Sun Directional Light (Even, high visibility) -->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.92 0.92 0.92 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <!-- Interior Fill Light 1 (West Dining Area) -->
    <light type="point" name="interior_light_west">
      <cast_shadows>false</cast_shadows>
      <pose>-6.0 0.0 4.0 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <attenuation>
        <range>25</range>
        <constant>0.6</constant>
        <linear>0.04</linear>
        <quadratic>0.002</quadratic>
      </attenuation>
    </light>

    <!-- Interior Fill Light 2 (East Kitchen & Bar Area) -->
    <light type="point" name="interior_light_east">
      <cast_shadows>false</cast_shadows>
      <pose>6.0 0.0 4.0 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <attenuation>
        <range>25</range>
        <constant>0.6</constant>
        <linear>0.04</linear>
        <quadratic>0.002</quadratic>
      </attenuation>
    </light>

    <!-- Scene Lighting & Background -->
    <scene>
      <ambient>0.82 0.82 0.85 1.0</ambient>
      <background>0.92 0.93 0.95 1.0</background>
      <shadows>false</shadows>
      <grid>true</grid>
    </scene>

    <!-- Global Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>120 120</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>120 120</size></plane></geometry>
          <material>
            <ambient>0.88 0.88 0.90 1</ambient>
            <diffuse>0.88 0.88 0.90 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================== -->
    <!-- RESTAURANT ARCHITECTURAL BLUEPRINT BOUNDARY                    -->
    <!-- Generated directly from floor plan measurements:               -->
    <!--   - North Wall: 24.27 m                                        -->
    <!--   - East Wall: 13.78 m                                         -->
    <!--   - South-East Wall: 12.78 m                                   -->
    <!--   - Entrance Slant Right: 2.00 m                               -->
    <!--   - Main Entrance Facade: 6.25 m                               -->
    <!--   - Left Entrance Indent: 1.30 m                               -->
    <!--   - West Slanted Wall: 13.96 m                                 -->
    <!--   - Kitchen Vertical Partition: 9.40 m                         -->
    <!--   - Kitchen Horizontal Partition: 5.53 m                       -->
    <!-- ============================================================== -->
    <model name="restaurant_boundary">
      <static>true</static>

      <!-- 1. RESTAURANT INTERIOR TILE FLOOR SLAB -->
      <link name="interior_floor">
        <visual name="floor_vis">
          <pose>0.0 0.0 0.002 0 0 0</pose>
          <geometry>
            <box><size>25.0 14.5 0.004</size></box>
          </geometry>
          <material>
            <ambient>0.80 0.80 0.82 1</ambient>
            <diffuse>0.80 0.80 0.82 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>

      <!-- 2. OUTER PERIMETER BOUNDARY WALLS -->
      <link name="perimeter_walls">

        <!-- [WALL 1] North wall (North Wall - 24.27m) -->
        <!-- from (-12.135, 6.890) to (12.135, 6.890) -->
        <visual name="wall_north_vis">
          <pose>0.0 6.890 1.40 0 0 0</pose>
          <geometry><box><size>24.27 0.20 2.80</size></box></geometry>
          <material><ambient>0.85 0.85 0.88 1</ambient><diffuse>0.85 0.85 0.88 1</diffuse></material>
        </visual>
        <collision name="wall_north_col">
          <pose>0.0 6.890 1.40 0 0 0</pose>
          <geometry><box><size>24.27 0.20 2.80</size></box></geometry>
        </collision>

        <!-- [WALL 2] East wall (East Wall - 13.78m) -->
        <!-- from (12.135, 6.890) to (12.135, -6.890) -->
        <visual name="wall_east_vis">
          <pose>12.135 0.0 1.40 0 0 -1.570796</pose>
          <geometry><box><size>13.78 0.20 2.80</size></box></geometry>
          <material><ambient>0.85 0.85 0.88 1</ambient><diffuse>0.85 0.85 0.88 1</diffuse></material>
        </visual>
        <collision name="wall_east_col">
          <pose>12.135 0.0 1.40 0 0 -1.570796</pose>
          <geometry><box><size>13.78 0.20 2.80</size></box></geometry>
        </collision>

        <!-- [WALL 3] Right-hand south wall (South-East Wall - 12.78m) -->
        <!-- from (12.135, -6.890) to (-0.645, -6.890) -->
        <visual name="wall_south_east_vis">
          <pose>5.745 -6.890 1.40 0 0 0</pose>
          <geometry><box><size>12.78 0.20 2.80</size></box></geometry>
          <material><ambient>0.85 0.85 0.88 1</ambient><diffuse>0.85 0.85 0.88 1</diffuse></material>
        </visual>
        <collision name="wall_south_east_col">
          <pose>5.745 -6.890 1.40 0 0 0</pose>
          <geometry><box><size>12.78 0.20 2.80</size></box></geometry>
        </collision>

        <!-- [WALL 4] Right entrance slant (Entrance Slant Right - 2.00m) -->
        <!-- from (-0.645, -6.890) to (-2.059, -8.304) -->
        <visual name="wall_entrance_slant_right_vis">
          <pose>-1.352 -7.597 1.40 0 0 -2.356194</pose>
          <geometry><box><size>2.00 0.20 2.80</size></box></geometry>
          <material><ambient>0.85 0.85 0.88 1</ambient><diffuse>0.85 0.85 0.88 1</diffuse></material>
        </visual>
        <collision name="wall_entrance_slant_right_col">
          <pose>-1.352 -7.597 1.40 0 0 -2.356194</pose>
          <geometry><box><size>2.00 0.20 2.80</size></box></geometry>
        </collision>

        <!-- [WALL 5] Main entrance facade (Main Entrance Facade - 6.25m) -->
        <!-- from (-2.059, -8.304) to (-7.833, -5.912) -->
        <visual name="wall_main_entrance_vis">
          <pose>-4.946 -7.108 1.40 0 0 2.74889</pose>
          <geometry><box><size>6.25 0.20 2.80</size></box></geometry>
          <material><ambient>0.80 0.82 0.85 1</ambient><diffuse>0.80 0.82 0.85 1</diffuse></material>
        </visual>
        <collision name="wall_main_entrance_col">
          <pose>-4.946 -7.108 1.40 0 0 2.74889</pose>
          <geometry><box><size>6.25 0.20 2.80</size></box></geometry>
        </collision>

        <!-- [WALL 6] Recessed segment left of the doorway (Entrance Indent - 1.30m) -->
        <!-- from (-7.833, -5.912) to (-9.128, -6.025) -->
        <visual name="wall_entrance_indent_vis">
          <pose>-8.481 -5.969 1.40 0 0 -3.0545</pose>
          <geometry><box><size>1.30 0.20 2.80</size></box></geometry>
          <material><ambient>0.85 0.85 0.88 1</ambient><diffuse>0.85 0.85 0.88 1</diffuse></material>
        </visual>
        <collision name="wall_entrance_indent_col">
          <pose>-8.481 -5.969 1.40 0 0 -3.0545</pose>
          <geometry><box><size>1.30 0.20 2.80</size></box></geometry>
        </collision>

        <!-- [WALL 7] Slanted west wall (West Slanted Wall - 13.96m) -->
        <!-- from (-9.128, -6.025) to (-12.135, 6.890) -->
        <visual name="wall_west_slant_vis">
          <pose>-10.631 0.432 1.40 0 0 1.7994</pose>
          <geometry><box><size>13.96 0.20 2.80</size></box></geometry>
          <material><ambient>0.85 0.85 0.88 1</ambient><diffuse>0.85 0.85 0.88 1</diffuse></material>
        </visual>
        <collision name="wall_west_slant_col">
          <pose>-10.631 0.432 1.40 0 0 1.7994</pose>
          <geometry><box><size>13.96 0.20 2.80</size></box></geometry>
        </collision>

      </link>

      <!-- 3. KITCHEN INTERIOR PARTITION WALLS & ROBOT SERVICE DOCK (Kitchen Area 09) -->
      <!-- Normalized to measured dimensions using the 5.53m line as reference: -->
      <!--   - 1.00m green wall segment (behind the robot) -->
      <!--   - Doorway / entrance width 1.00m -->
      <!--   - Horizontal magenta wall segment 1.00m -->
      <!--   - Thick eastern oven / kitchen block -->
      <link name="kitchen_walls">

        <!-- [MAIN LONGITUDINAL KITCHEN WALL] From the north wall to the kitchen entrance: length 8.40m -->
        <!-- from (6.605, 6.890) down to (6.605, -1.510) -->
        <visual name="kitchen_vert_main_vis">
          <pose>6.605 2.690 1.40 0 0 -1.570796</pose>
          <geometry><box><size>8.40 0.15 2.80</size></box></geometry>
          <material><ambient>0.92 0.92 0.95 1</ambient><diffuse>0.92 0.92 0.95 1</diffuse></material>
        </visual>
        <collision name="kitchen_vert_main_col">
          <pose>6.605 2.690 1.40 0 0 -1.570796</pose>
          <geometry><box><size>8.40 0.15 2.80</size></box></geometry>
        </collision>

        <!-- [1.00M GREEN WALL] Wall behind the robot for charging / food pickup -->
        <!-- from (6.605, -1.510) down to to reference line (6.605, -2.510) -->
        <visual name="wall_robot_dock_green_vis">
          <pose>6.605 -2.010 1.40 0 0 -1.570796</pose>
          <geometry><box><size>1.00 0.15 2.80</size></box></geometry>
          <material>
            <ambient>0.20 0.65 0.25 1</ambient>
            <diffuse>0.25 0.75 0.30 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="wall_robot_dock_green_col">
          <pose>6.605 -2.010 1.40 0 0 -1.570796</pose>
          <geometry><box><size>1.00 0.15 2.80</size></box></geometry>
        </collision>

        <!-- [SHORT WALL SEGMENT BESIDE DOOR] Connects the green wall to the door edge: length 0.78m -->
        <!-- at Y = -1.510, from X = 6.605 to X = 7.385 -->
        <visual name="wall_dock_stub_vis">
          <pose>6.995 -1.510 1.40 0 0 0</pose>
          <geometry><box><size>0.78 0.15 2.80</size></box></geometry>
          <material><ambient>0.92 0.92 0.95 1</ambient><diffuse>0.92 0.92 0.95 1</diffuse></material>
        </visual>
        <collision name="wall_dock_stub_col">
          <pose>6.995 -1.510 1.40 0 0 0</pose>
          <geometry><box><size>0.78 0.15 2.80</size></box></geometry>
        </collision>

        <!-- KITCHEN DOOR OPENING: Door width 1.00m (from X = 7.385 to X = 8.385 at Y = -1.510) -->
        <!-- (Wall-free opening for robot access) -->

        <!-- [1.00M MAGENTA WALL] Wall segment right of the kitchen door: length 1.00m -->
        <!-- at Y = -1.510, from X = 8.385 to X = 9.385 -->
        <visual name="wall_dock_magenta_vis">
          <pose>8.885 -1.510 1.40 0 0 0</pose>
          <geometry><box><size>1.00 0.15 2.80</size></box></geometry>
          <material>
            <ambient>0.75 0.15 0.70 1</ambient>
            <diffuse>0.85 0.20 0.80 1</diffuse>
          </material>
        </visual>
        <collision name="wall_dock_magenta_col">
          <pose>8.885 -1.510 1.40 0 0 0</pose>
          <geometry><box><size>1.00 0.15 2.80</size></box></geometry>
        </collision>

        <!-- [EASTERN OVEN / COOKING BLOCK] Thick wall block from X = 9.385 to East wall -->
        <visual name="kitchen_oven_block_vis">
          <pose>10.760 -2.010 1.40 0 0 0</pose>
          <geometry><box><size>2.75 1.00 2.80</size></box></geometry>
          <material><ambient>0.30 0.30 0.33 1</ambient><diffuse>0.30 0.30 0.33 1</diffuse></material>
        </visual>
        <collision name="kitchen_oven_block_col">
          <pose>10.760 -2.010 1.40 0 0 0</pose>
          <geometry><box><size>2.75 1.00 2.80</size></box></geometry>
        </collision>

        <!-- [REFERENCE-LINE WALL WITH 1.00M DOOR FOR ROBOT ACCESS TO MAIN HALL (AREA 08)] -->
        <!-- Wall segment left of the door: length 1.78m from X = 6.605 to X = 8.385 at Y = -2.510 -->
        <visual name="kitchen_horiz_left_vis">
          <pose>7.495 -2.510 1.40 0 0 0</pose>
          <geometry><box><size>1.78 0.15 2.80</size></box></geometry>
          <material><ambient>0.92 0.92 0.95 1</ambient><diffuse>0.92 0.92 0.95 1</diffuse></material>
        </visual>
        <collision name="kitchen_horiz_left_col">
          <pose>7.495 -2.510 1.40 0 0 0</pose>
          <geometry><box><size>1.78 0.15 2.80</size></box></geometry>
        </collision>

        <!-- MAIN HALL OPENING: Door width 1.00m (from X = 8.385 to X = 9.385 at Y = -2.510) -->
        <!-- Opposite the magenta wall segment so the robot can travel straight into the main hall -->

        <!-- [ROBOT PARKING POSITION (HOME DOCK) - AREA 08 MAIN HALL] -->
        <!-- Placed at X = 8.85, Y = -3.80 (open Area 08 hall outside the kitchen, facing west at 3.14159 rad) -->
        <visual name="robot_dock_pad_vis">
          <pose>8.85 -3.80 0.008 0 0 3.14159</pose>
          <geometry><box><size>0.80 0.65 0.016</size></box></geometry>
          <material>
            <ambient>0.95 0.70 0.05 1</ambient>
            <diffuse>0.95 0.70 0.05 1</diffuse>
          </material>
        </visual>
        <visual name="robot_dock_arrow_vis">
          <pose>8.70 -3.80 0.018 0 0 3.14159</pose>
          <geometry><box><size>0.30 0.12 0.005</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>

      </link>

      <!-- 4. AREA 08 STANDING COUNTERS & BAR 04 (Area 08: Standing counters and Bar 04) -->
      <!-- Dimensions based on drawing measurements: -->
      <!--   - Standing counter against east wall: width 0.69m x length 3.58m x height 1.05m -->
      <!--   - Standing counter against south wall: width 0.69m x length 6.02m x height 1.05m -->
      <!--   - Southeast corner connection: 0.69m x 0.69m x 1.05m -->
      <!--   - Bar 04: Longitudinal body width 0.60m x length 2.735m, counter head width 0.42m, step offset 0.41m, aisle width 1.00m -->
      <!--   - 2 round booth tables in central Area 08 -->
      <link name="area_08_furniture">

        <!-- [STANDING COUNTER ROW - EAST SIDE: 0.69m x 3.58m] -->
        <!-- Against the east wall (X = 12.135m), length 3.58m from Y = -2.510 down to Y = -6.090 -->
        <visual name="standing_counter_east_vis">
          <pose>11.790 -4.300 0.525 0 0 0</pose>
          <geometry><box><size>0.69 3.58 1.05</size></box></geometry>
          <material>
            <ambient>0.32 0.22 0.15 1</ambient>
            <diffuse>0.48 0.33 0.22 1</diffuse>
          </material>
        </visual>
        <collision name="standing_counter_east_col">
          <pose>11.790 -4.300 0.525 0 0 0</pose>
          <geometry><box><size>0.69 3.58 1.05</size></box></geometry>
        </collision>

        <!-- [SOUTHEAST CONNECTION OF STANDING COUNTERS: 0.69m x 0.69m] -->
        <visual name="standing_counter_corner_vis">
          <pose>11.790 -6.545 0.525 0 0 0</pose>
          <geometry><box><size>0.69 0.69 1.05</size></box></geometry>
          <material>
            <ambient>0.32 0.22 0.15 1</ambient>
            <diffuse>0.48 0.33 0.22 1</diffuse>
          </material>
        </visual>
        <collision name="standing_counter_corner_col">
          <pose>11.790 -6.545 0.525 0 0 0</pose>
          <geometry><box><size>0.69 0.69 1.05</size></box></geometry>
        </collision>

        <!-- [STANDING COUNTER ROW - SOUTH SIDE: 6.02m x 0.69m] -->
        <!-- Against the south wall (Y = -6.890m), length 6.02m from X = 11.445 westward to X = 5.425 -->
        <visual name="standing_counter_south_vis">
          <pose>8.435 -6.545 0.525 0 0 0</pose>
          <geometry><box><size>6.02 0.69 1.05</size></box></geometry>
          <material>
            <ambient>0.32 0.22 0.15 1</ambient>
            <diffuse>0.48 0.33 0.22 1</diffuse>
          </material>
        </visual>
        <collision name="standing_counter_south_col">
          <pose>8.435 -6.545 0.525 0 0 0</pose>
          <geometry><box><size>6.02 0.69 1.05</size></box></geometry>
        </collision>

        <!-- [CONTINUOUS CONNECTION FROM SOUTH COUNTER TO BAR 04 BASE: length 1.325m x width 0.69m] -->
        <!-- Connects from the south counter edge X = 5.425m to the slanted counter base at X = 4.10m, flush against the south wall -->
        <visual name="counter_south_join_vis">
          <pose>4.762 -6.545 0.525 0 0 0</pose>
          <geometry><box><size>1.325 0.69 1.05</size></box></geometry>
          <material>
            <ambient>0.32 0.22 0.15 1</ambient>
            <diffuse>0.48 0.33 0.22 1</diffuse>
          </material>
        </visual>
        <collision name="counter_south_join_col">
          <pose>4.762 -6.545 0.525 0 0 0</pose>
          <geometry><box><size>1.325 0.69 1.05</size></box></geometry>
        </collision>

        <!-- [BAR 04 COUNTER ROW - SLANTED 105 DEGREES TO WEST (INNER COUNTER): Thickness 0.44m x length 3.51m] -->
        <!-- Slanted 105 degrees, recessed to meet the south counter row and south wall -->
        <visual name="bar_04_inner_slanted_vis">
          <pose>3.968 -5.520 0.525 0 0 0.2618</pose>
          <geometry><box><size>0.44 2.837 1.05</size></box></geometry>
          <material>
            <ambient>0.36 0.26 0.18 1</ambient>
            <diffuse>0.52 0.38 0.26 1</diffuse>
          </material>
        </visual>
        <collision name="bar_04_inner_slanted_col">
          <pose>3.968 -5.520 0.525 0 0 0.2618</pose>
          <geometry><box><size>0.44 2.837 1.05</size></box></geometry>
        </collision>

        <!-- [COUNTER BESIDE BAR 04 - SLANTED 105 DEGREES (OUTER COUNTER): Thickness 0.69m x length 3.51m] -->
        <!-- Requested light granite design, flush against the west edge of the 0.44m counter and meeting the south wall -->
        <visual name="bar_04_outer_slanted_vis">
          <pose>3.422 -5.520 0.525 0 0 0.2618</pose>
          <geometry><box><size>0.69 2.837 1.05</size></box></geometry>
          <material>
            <ambient>0.82 0.80 0.78 1</ambient>
            <diffuse>0.85 0.83 0.80 1</diffuse>
          </material>
        </visual>
        <collision name="bar_04_outer_slanted_col">
          <pose>3.422 -5.520 0.525 0 0 0.2618</pose>
          <geometry><box><size>0.69 2.837 1.05</size></box></geometry>
        </collision>

        <!-- [NORTH END OF BAR 04: length 2.11m x Thickness 0.44m x height 1.05m] -->
        <!-- Continuous across the top of both slanted counters, leaving clear access to room 07 -->
        <visual name="bar_04_top_cap_vis">
          <pose>3.550 -3.930 0.525 0 0 0</pose>
          <geometry><box><size>2.11 0.44 1.05</size></box></geometry>
          <material>
            <ambient>0.36 0.26 0.18 1</ambient>
            <diffuse>0.52 0.38 0.26 1</diffuse>
          </material>
        </visual>
        <collision name="bar_04_top_cap_col">
          <pose>3.550 -3.930 0.525 0 0 0</pose>
          <geometry><box><size>2.11 0.44 1.05</size></box></geometry>
        </collision>
                        <!-- [4 ROUND STOOLS WEST OF BAR 04: Diameter 0.34m, height 0.75m, central pedestal] -->
        <!-- Chair 1 (bottom): X = 3.022m, Y = -6.733m -->
        <visual name="stool_1_cushion_vis">
          <pose>3.022 -6.733 0.710 0 0 0</pose>
          <geometry><cylinder><radius>0.17</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>0.80 0.70 0.55 1</ambient><diffuse>0.85 0.75 0.60 1</diffuse></material>
        </visual>
        <visual name="stool_1_stem_vis">
          <pose>3.022 -6.733 0.345 0 0 0</pose>
          <geometry><cylinder><radius>0.035</radius><length>0.65</length></cylinder></geometry>
          <material><ambient>0.20 0.20 0.22 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material>
        </visual>
        <visual name="stool_1_base_vis">
          <pose>3.022 -6.733 0.010 0 0 0</pose>
          <geometry><cylinder><radius>0.14</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.20 0.20 0.22 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material>
        </visual>
        <collision name="stool_1_cushion_col">
          <pose>3.022 -6.733 0.710 0 0 0</pose>
          <geometry><cylinder><radius>0.17</radius><length>0.08</length></cylinder></geometry>
        </collision>
        <collision name="stool_1_stem_col">
          <pose>3.022 -6.733 0.345 0 0 0</pose>
          <geometry><cylinder><radius>0.035</radius><length>0.65</length></cylinder></geometry>
        </collision>
        <collision name="stool_1_base_col">
          <pose>3.022 -6.733 0.010 0 0 0</pose>
          <geometry><cylinder><radius>0.14</radius><length>0.02</length></cylinder></geometry>
        </collision>

        <!-- Chair 2: X = 2.854m, Y = -6.105m -->
        <visual name="stool_2_cushion_vis">
          <pose>2.854 -6.105 0.710 0 0 0</pose>
          <geometry><cylinder><radius>0.17</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>0.80 0.70 0.55 1</ambient><diffuse>0.85 0.75 0.60 1</diffuse></material>
        </visual>
        <visual name="stool_2_stem_vis">
          <pose>2.854 -6.105 0.345 0 0 0</pose>
          <geometry><cylinder><radius>0.035</radius><length>0.65</length></cylinder></geometry>
