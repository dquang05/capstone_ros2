<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="restaurant_blueprint_world">

    <!-- ============================================================== -->
    <!-- Physics Engine Configuration (Smooth 250 Hz for Real-time Sim) -->
    <!-- ============================================================== -->
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential Gazebo Harmonic System Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Sun Directional Light (Even, high visibility) -->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.92 0.92 0.92 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <!-- Interior Fill Light 1 (West Dining Area) -->
    <light type="point" name="interior_light_west">
      <cast_shadows>false</cast_shadows>
      <pose>-6.0 0.0 4.0 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <attenuation>
        <range>25</range>
        <constant>0.6</constant>
        <linear>0.04</linear>
        <quadratic>0.002</quadratic>
      </attenuation>
    </light>

    <!-- Interior Fill Light 2 (East Kitchen & Bar Area) -->
    <light type="point" name="interior_light_east">
      <cast_shadows>false</cast_shadows>
      <pose>6.0 0.0 4.0 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <attenuation>
        <range>25</range>
        <constant>0.6</constant>
        <linear>0.04</linear>
        <quadratic>0.002</quadratic>
      </attenuation>
    </light>

    <!-- Scene Lighting & Background -->
    <scene>
      <ambient>0.82 0.82 0.85 1.0</ambient>
      <background>0.92 0.93 0.95 1.0</background>
      <shadows>false</shadows>
      <grid>true</grid>
    </scene>

    <!-- Global Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>120 120</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>120 120</size></plane></geometry>
          <material>
            <ambient>0.88 0.88 0.90 1</ambient>
            <diffuse>0.88 0.88 0.90 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================== -->
    <!-- RESTAURANT ARCHITECTURAL BLUEPRINT BOUNDARY                    -->
    <!-- Generated directly from floor plan measurements:               -->
    <!--   - North Wall: 24.27 m                                        -->
    <!--   - East Wall: 13.78 m                                         -->
    <!--   - South-East Wall: 12.78 m                                   -->
    <!--   - Entrance Slant Right: 2.00 m                               -->
    <!--   - Main Entrance Facade: 6.25 m                               -->
    <!--   - Left Entrance Indent: 1.30 m                               -->
    <!--   - West Slanted Wall: 13.96 m                                 -->
    <!--   - Kitchen Vertical Partition: 9.40 m                         -->
    <!--   - Kitchen Horizontal Partition: 5.53 m                       -->
    <!-- ============================================================== -->
    <model name="restaurant_boundary">
      <static>true</static>

      <!-- 1. RESTAURANT INTERIOR TILE FLOOR SLAB -->
      <link name="interior_floor">
        <visual name="floor_vis">
          <pose>0.0 0.0 0.002 0 0 0</pose>
          <geometry>
            <box><size>25.0 14.5 0.004</size></box>
          </geometry>
          <material>
            <ambient>0.80 0.80 0.82 1</ambient>
            <diffuse>0.80 0.80 0.82 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>

      <!-- 2. OUTER PERIMETER BOUNDARY WALLS -->
      <link name="perimeter_walls">

        <!-- [WALL 1] Tường Bắc (North Wall - 24.27m) -->
        <!-- Từ (-12.135, 6.890) đến (12.135, 6.890) -->
        <visual name="wall_north_vis">
          <pose>0.0 6.890 1.40 0 0 0</pose>
          <geometry><box><size>24.27 0.20 2.80</size></box></geometry>
          <material><ambient>0.85 0.85 0.88 1</ambient><diffuse>0.85 0.85 0.88 1</diffuse></material>
        </visual>
        <collision name="wall_north_col">
          <pose>0.0 6.890 1.40 0 0 0</pose>
          <geometry><box><size>24.27 0.20 2.80</size></box></geometry>
        </collision>

        <!-- [WALL 2] Tường Đông (East Wall - 13.78m) -->
        <!-- Từ (12.135, 6.890) đến (12.135, -6.890) -->
        <visual name="wall_east_vis">
          <pose>12.135 0.0 1.40 0 0 -1.570796</pose>
          <geometry><box><size>13.78 0.20 2.80</size></box></geometry>
          <material><ambient>0.85 0.85 0.88 1</ambient><diffuse>0.85 0.85 0.88 1</diffuse></material>
        </visual>
        <collision name="wall_east_col">
          <pose>12.135 0.0 1.40 0 0 -1.570796</pose>
          <geometry><box><size>13.78 0.20 2.80</size></box></geometry>
        </collision>

        <!-- [WALL 3] Tường Nam bên phải (South-East Wall - 12.78m) -->
        <!-- Từ (12.135, -6.890) đến (-0.645, -6.890) -->
        <visual name="wall_south_east_vis">
          <pose>5.745 -6.890 1.40 0 0 0</pose>
          <geometry><box><size>12.78 0.20 2.80</size></box></geometry>
          <material><ambient>0.85 0.85 0.88 1</ambient><diffuse>0.85 0.85 0.88 1</diffuse></material>
        </visual>
        <collision name="wall_south_east_col">
          <pose>5.745 -6.890 1.40 0 0 0</pose>
          <geometry><box><size>12.78 0.20 2.80</size></box></geometry>
        </collision>

        <!-- [WALL 4] Đoạn vát sảnh vào bên phải (Entrance Slant Right - 2.00m) -->
        <!-- Từ (-0.645, -6.890) đến (-2.059, -8.304) -->
        <visual name="wall_entrance_slant_right_vis">
          <pose>-1.352 -7.597 1.40 0 0 -2.356194</pose>
          <geometry><box><size>2.00 0.20 2.80</size></box></geometry>
          <material><ambient>0.85 0.85 0.88 1</ambient><diffuse>0.85 0.85 0.88 1</diffuse></material>
        </visual>
        <collision name="wall_entrance_slant_right_col">
          <pose>-1.352 -7.597 1.40 0 0 -2.356194</pose>
          <geometry><box><size>2.00 0.20 2.80</size></box></geometry>
        </collision>

        <!-- [WALL 5] Mặt tiền sảnh chính (Main Entrance Facade - 6.25m) -->
        <!-- Từ (-2.059, -8.304) đến (-7.833, -5.912) -->
        <visual name="wall_main_entrance_vis">
          <pose>-4.946 -7.108 1.40 0 0 2.74889</pose>
          <geometry><box><size>6.25 0.20 2.80</size></box></geometry>
          <material><ambient>0.80 0.82 0.85 1</ambient><diffuse>0.80 0.82 0.85 1</diffuse></material>
        </visual>
        <collision name="wall_main_entrance_col">
          <pose>-4.946 -7.108 1.40 0 0 2.74889</pose>
          <geometry><box><size>6.25 0.20 2.80</size></box></geometry>
        </collision>

        <!-- [WALL 6] Đoạn gấp khúc thụt vào bên trái cửa (Entrance Indent - 1.30m) -->
        <!-- Từ (-7.833, -5.912) đến (-9.128, -6.025) -->
        <visual name="wall_entrance_indent_vis">
          <pose>-8.481 -5.969 1.40 0 0 -3.0545</pose>
          <geometry><box><size>1.30 0.20 2.80</size></box></geometry>
          <material><ambient>0.85 0.85 0.88 1</ambient><diffuse>0.85 0.85 0.88 1</diffuse></material>
        </visual>
        <collision name="wall_entrance_indent_col">
          <pose>-8.481 -5.969 1.40 0 0 -3.0545</pose>
          <geometry><box><size>1.30 0.20 2.80</size></box></geometry>
        </collision>

        <!-- [WALL 7] Tường chéo bên Tây (West Slanted Wall - 13.96m) -->
        <!-- Từ (-9.128, -6.025) đến (-12.135, 6.890) -->
        <visual name="wall_west_slant_vis">
          <pose>-10.631 0.432 1.40 0 0 1.7994</pose>
          <geometry><box><size>13.96 0.20 2.80</size></box></geometry>
          <material><ambient>0.85 0.85 0.88 1</ambient><diffuse>0.85 0.85 0.88 1</diffuse></material>
        </visual>
        <collision name="wall_west_slant_col">
          <pose>-10.631 0.432 1.40 0 0 1.7994</pose>
          <geometry><box><size>13.96 0.20 2.80</size></box></geometry>
        </collision>

      </link>

      <!-- 3. KITCHEN INTERIOR PARTITION WALLS & ROBOT SERVICE DOCK (Khu Bếp 09) -->
      <!-- Chuẩn hóa theo số đo thực tế lấy đường 5.53m làm chuẩn: -->
      <!--   - Đoạn tường màu xanh lá 1.00m (chỗ Robot quay lưng vào) -->
      <!--   - Cửa đi / Lối ra vào rộng 1.00m -->
      <!--   - Đoạn tường ngang màu tím hồng 1.00m -->
      <!--   - Khối lò nướng / bếp dày phía Đông -->
      <link name="kitchen_walls">

        <!-- [TƯỜNG DỌC CHÍNH BẾP] Từ tường Bắc xuống đến lối vào bếp: dài 8.40m -->
        <!-- Từ (6.605, 6.890) xuống (6.605, -1.510) -->
        <visual name="kitchen_vert_main_vis">
          <pose>6.605 2.690 1.40 0 0 -1.570796</pose>
          <geometry><box><size>8.40 0.15 2.80</size></box></geometry>
          <material><ambient>0.92 0.92 0.95 1</ambient><diffuse>0.92 0.92 0.95 1</diffuse></material>
        </visual>
        <collision name="kitchen_vert_main_col">
          <pose>6.605 2.690 1.40 0 0 -1.570796</pose>
          <geometry><box><size>8.40 0.15 2.80</size></box></geometry>
        </collision>

        <!-- [TƯỜNG XANH LÁ 1.00M] Đoạn tường Robot quay lưng vào để sạc / nhận thức ăn -->
        <!-- Từ (6.605, -1.510) xuống đến đường chuẩn (6.605, -2.510) -->
        <visual name="wall_robot_dock_green_vis">
          <pose>6.605 -2.010 1.40 0 0 -1.570796</pose>
          <geometry><box><size>1.00 0.15 2.80</size></box></geometry>
          <material>
            <ambient>0.20 0.65 0.25 1</ambient>
            <diffuse>0.25 0.75 0.30 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="wall_robot_dock_green_col">
          <pose>6.605 -2.010 1.40 0 0 -1.570796</pose>
          <geometry><box><size>1.00 0.15 2.80</size></box></geometry>
        </collision>

        <!-- [ĐOẠN TƯỜNG NGẮN CẠNH CỬA] Nối từ tường xanh lá ra mép cửa: dài 0.78m -->
        <!-- Tại Y = -1.510, từ X = 6.605 đến X = 7.385 -->
        <visual name="wall_dock_stub_vis">
          <pose>6.995 -1.510 1.40 0 0 0</pose>
          <geometry><box><size>0.78 0.15 2.80</size></box></geometry>
          <material><ambient>0.92 0.92 0.95 1</ambient><diffuse>0.92 0.92 0.95 1</diffuse></material>
        </visual>
        <collision name="wall_dock_stub_col">
          <pose>6.995 -1.510 1.40 0 0 0</pose>
          <geometry><box><size>0.78 0.15 2.80</size></box></geometry>
        </collision>

        <!-- KHOẢNG MỞ CỬA BẾP: Cửa rộng 1.00m (từ X = 7.385 đến X = 8.385 tại Y = -1.510) -->
        <!-- (Khoảng trống không có tường để Robot di chuyển ra vào) -->

        <!-- [TƯỜNG TÍM HỒNG 1.00M] Đoạn tường bên phải cửa bếp: dài 1.00m -->
        <!-- Tại Y = -1.510, từ X = 8.385 đến X = 9.385 -->
        <visual name="wall_dock_magenta_vis">
          <pose>8.885 -1.510 1.40 0 0 0</pose>
          <geometry><box><size>1.00 0.15 2.80</size></box></geometry>
          <material>
            <ambient>0.75 0.15 0.70 1</ambient>
            <diffuse>0.85 0.20 0.80 1</diffuse>
          </material>
        </visual>
        <collision name="wall_dock_magenta_col">
          <pose>8.885 -1.510 1.40 0 0 0</pose>
          <geometry><box><size>1.00 0.15 2.80</size></box></geometry>
        </collision>

        <!-- [KHỐI LÒ NƯỚNG / BẾP NẤU PHÍA ĐÔNG] Khối tường dày từ X = 9.385 đến tường Đông -->
        <visual name="kitchen_oven_block_vis">
          <pose>10.760 -2.010 1.40 0 0 0</pose>
          <geometry><box><size>2.75 1.00 2.80</size></box></geometry>
          <material><ambient>0.30 0.30 0.33 1</ambient><diffuse>0.30 0.30 0.33 1</diffuse></material>
        </visual>
        <collision name="kitchen_oven_block_col">
          <pose>10.760 -2.010 1.40 0 0 0</pose>
          <geometry><box><size>2.75 1.00 2.80</size></box></geometry>
        </collision>

        <!-- [TƯỜNG ĐƯỜNG CHUẨN ĐÃ KHOÉT CỬA 1.00M CHO ROBOT RA ĐẠI SẢNH (AREA 08)] -->
        <!-- Đoạn tường bên trái cửa: dài 1.78m từ X = 6.605 đến X = 8.385 tại Y = -2.510 -->
        <visual name="kitchen_horiz_left_vis">
          <pose>7.495 -2.510 1.40 0 0 0</pose>
          <geometry><box><size>1.78 0.15 2.80</size></box></geometry>
          <material><ambient>0.92 0.92 0.95 1</ambient><diffuse>0.92 0.92 0.95 1</diffuse></material>
        </visual>
        <collision name="kitchen_horiz_left_col">
          <pose>7.495 -2.510 1.40 0 0 0</pose>
          <geometry><box><size>1.78 0.15 2.80</size></box></geometry>
        </collision>

        <!-- KHOẢNG MỞ RA ĐẠI SẢNH: Cửa rộng 1.00m (từ X = 8.385 đến X = 9.385 tại Y = -2.510) -->
        <!-- Nằm đối diện trực diện với đoạn tường màu tím hồng để Robot đi thẳng ra đại sảnh -->

        <!-- [VỊ TRÍ ĐỖ XE ROBOT (HOME DOCK) - AREA 08 MAIN HALL] -->
        <!-- Đặt tại X = 8.85, Y = -3.80 (sảnh mở Area 08 ngoài cửa bếp, quay mặt về hướng Tây 3.14159 rad) -->
        <visual name="robot_dock_pad_vis">
          <pose>8.85 -3.80 0.008 0 0 3.14159</pose>
          <geometry><box><size>0.80 0.65 0.016</size></box></geometry>
          <material>
            <ambient>0.95 0.70 0.05 1</ambient>
            <diffuse>0.95 0.70 0.05 1</diffuse>
          </material>
        </visual>
        <visual name="robot_dock_arrow_vis">
          <pose>8.70 -3.80 0.018 0 0 3.14159</pose>
          <geometry><box><size>0.30 0.12 0.005</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>

      </link>

      <!-- 4. AREA 08 STANDING COUNTERS & BAR 04 (Khu 08: Dãy bàn phục vụ khách đứng & Quầy Bar 04) -->
      <!-- Kích thước căn chuẩn xác theo số đo thực tế từ bản vẽ: -->
      <!--   - Bàn đứng dựa tường Đông: Rộng 0.69m x Dài 3.58m x Cao 1.05m -->
      <!--   - Bàn đứng dựa tường Nam: Rộng 0.69m x Dài 6.02m x Cao 1.05m -->
      <!--   - Góc tiếp giáp Đông - Nam: 0.69m x 0.69m x 1.05m -->
      <!--   - Quầy Bar 04: Thân dọc rộng 0.60m x dài 2.735m, đầu quầy rộng 0.42m, giật cấp 0.41m, lối đi 1.00m -->
      <!--   - 2 Bàn tròn quầy Booth trung tâm khu 08 -->
      <link name="area_08_furniture">

        <!-- [DÃY BÀN KHÁCH ĐỨNG - CẠNH ĐÔNG: 0.69m x 3.58m] -->
        <!-- Tựa vào tường Đông (X = 12.135m), dài 3.58m từ Y = -2.510 xuống Y = -6.090 -->
        <visual name="standing_counter_east_vis">
          <pose>11.790 -4.300 0.525 0 0 0</pose>
          <geometry><box><size>0.69 3.58 1.05</size></box></geometry>
          <material>
            <ambient>0.32 0.22 0.15 1</ambient>
            <diffuse>0.48 0.33 0.22 1</diffuse>
          </material>
        </visual>
        <collision name="standing_counter_east_col">
          <pose>11.790 -4.300 0.525 0 0 0</pose>
          <geometry><box><size>0.69 3.58 1.05</size></box></geometry>
        </collision>

        <!-- [GÓC NỐI ĐÔNG - NAM CỦA DÃY BÀN ĐỨNG: 0.69m x 0.69m] -->
        <visual name="standing_counter_corner_vis">
          <pose>11.790 -6.545 0.525 0 0 0</pose>
          <geometry><box><size>0.69 0.69 1.05</size></box></geometry>
          <material>
            <ambient>0.32 0.22 0.15 1</ambient>
            <diffuse>0.48 0.33 0.22 1</diffuse>
          </material>
        </visual>
        <collision name="standing_counter_corner_col">
          <pose>11.790 -6.545 0.525 0 0 0</pose>
          <geometry><box><size>0.69 0.69 1.05</size></box></geometry>
        </collision>

        <!-- [DÃY BÀN KHÁCH ĐỨNG - CẠNH NAM: 6.02m x 0.69m] -->
        <!-- Tựa vào tường Nam (Y = -6.890m), dài 6.02m từ X = 11.445 sang Tây đến X = 5.425 -->
        <visual name="standing_counter_south_vis">
          <pose>8.435 -6.545 0.525 0 0 0</pose>
          <geometry><box><size>6.02 0.69 1.05</size></box></geometry>
          <material>
            <ambient>0.32 0.22 0.15 1</ambient>
            <diffuse>0.48 0.33 0.22 1</diffuse>
          </material>
        </visual>
        <collision name="standing_counter_south_col">
          <pose>8.435 -6.545 0.525 0 0 0</pose>
          <geometry><box><size>6.02 0.69 1.05</size></box></geometry>
        </collision>

        <!-- [ĐOẠN NỐI LIỀN MẠCH BÀN PHÍA NAM VỚI CHÂN QUẦY BAR 04: Dài 1.325m x Rộng 0.69m] -->
        <!-- Nối từ mép bàn phía Nam X = 5.425m đến chân quầy nghiêng tại X = 4.10m, áp sát tường Nam -->
        <visual name="counter_south_join_vis">
          <pose>4.762 -6.545 0.525 0 0 0</pose>
          <geometry><box><size>1.325 0.69 1.05</size></box></geometry>
          <material>
            <ambient>0.32 0.22 0.15 1</ambient>
            <diffuse>0.48 0.33 0.22 1</diffuse>
          </material>
        </visual>
        <collision name="counter_south_join_col">
          <pose>4.762 -6.545 0.525 0 0 0</pose>
          <geometry><box><size>1.325 0.69 1.05</size></box></geometry>
        </collision>

        <!-- [DÃY BÀN QUẦY 04 - NGHIÊNG 105 ĐỘ PHÍA TÂY (QUẦY TRONG): Dày 0.44m x Dài 3.51m] -->
        <!-- Nghiêng 105 độ, thụt sâu xuống đụng thẳng vào dãy bàn phía Nam và tường Nam -->
        <visual name="bar_04_inner_slanted_vis">
          <pose>3.968 -5.520 0.525 0 0 0.2618</pose>
          <geometry><box><size>0.44 2.837 1.05</size></box></geometry>
          <material>
            <ambient>0.36 0.26 0.18 1</ambient>
            <diffuse>0.52 0.38 0.26 1</diffuse>
          </material>
        </visual>
        <collision name="bar_04_inner_slanted_col">
          <pose>3.968 -5.520 0.525 0 0 0.2618</pose>
          <geometry><box><size>0.44 2.837 1.05</size></box></geometry>
        </collision>

        <!-- [DÃY BÀN KẾ BÊN QUẦY 04 - NGHIÊNG 105 ĐỘ (QUẦY NGOÀI): Dày 0.69m x Dài 3.51m] -->
        <!-- Thiết kế đá granite sáng màu theo yêu cầu, áp khít mép Tây của quầy 0.44m, đụng thẳng vào tường Nam -->
        <visual name="bar_04_outer_slanted_vis">
          <pose>3.422 -5.520 0.525 0 0 0.2618</pose>
          <geometry><box><size>0.69 2.837 1.05</size></box></geometry>
          <material>
            <ambient>0.82 0.80 0.78 1</ambient>
            <diffuse>0.85 0.83 0.80 1</diffuse>
          </material>
        </visual>
        <collision name="bar_04_outer_slanted_col">
          <pose>3.422 -5.520 0.525 0 0 0.2618</pose>
          <geometry><box><size>0.69 2.837 1.05</size></box></geometry>
        </collision>

        <!-- [ĐẦU QUẦY BAR 04 PHÍA BẮC: Dài 2.11m x Dày 0.44m x Cao 1.05m] -->
        <!-- Liền mạch trên đỉnh 2 quầy nghiêng, lối đi thông thoáng lên phòng 07 -->
        <visual name="bar_04_top_cap_vis">
          <pose>3.550 -3.930 0.525 0 0 0</pose>
          <geometry><box><size>2.11 0.44 1.05</size></box></geometry>
          <material>
            <ambient>0.36 0.26 0.18 1</ambient>
            <diffuse>0.52 0.38 0.26 1</diffuse>
          </material>
        </visual>
